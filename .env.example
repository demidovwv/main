# Copy this file to .env. Fill in your values locally; don't send the token in chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Optional Avito browser proxy. Leave empty when a VPN/TUN already routes the whole machine.
# Set this when the Russian exit is only a local SOCKS/HTTP port.
# Example: socks5://127.0.0.1:1080
# Inside Docker, 127.0.0.1 is the container itself, not the host VPN.
AVITO_PROXY_SERVER=
AVITO_PROXY_USERNAME=
AVITO_PROXY_PASSWORD=

# Optional: chrome (if Google Chrome is installed); empty uses Playwright Chromium.
BROWSER_CHANNEL=
# Reuse a dedicated EXISTING profile only with the same browser, after closing
# every browser process using that profile. Never use a primary daily profile.
BROWSER_PROFILE_DIR=
# false keeps a visible window for normal runs too; requires a GUI session.
BROWSER_HEADLESS=true
# Alternative to BROWSER_CHANNEL: absolute path to the exact browser executable.
BROWSER_EXECUTABLE_PATH=
# WATCH_STATE_DIR=/opt/avito-book-watch/data
